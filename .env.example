# Copy to .env and fill in real values. Never commit .env.

# ---- Server ----
PORT=5000
# Comma-separated list of allowed browser origins. Exact scheme and host,
# no trailing slash. On the live host this must list the real site, e.g.
#   CORS_ORIGINS=https://aqeaw.example.com
CORS_ORIGINS=http://localhost:3000

# Local development only: also accept localhost and private LAN addresses
# (10.x, 192.168.x, 172.16-31.x) so the site works from a phone on the same
# Wi-Fi. Defaults to OFF — leave it out entirely on any deployed host.
# NODE_ENV=production disables it even if this is "true".
ALLOW_LAN_ORIGINS=true

# Set to "production" on the live host.
NODE_ENV=development

# ---- Database ----
# Files are stored in GridFS in this same database.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/aqeaw

# ---- Uploads ----
# Per-file limit for application attachments.
MAX_FILE_SIZE_MB=10

# ---- Email (SMTP) ----
# Used for submission notifications, applicant confirmations,
# and the 6-digit dashboard login codes.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=no-reply@example.com
SMTP_PASS=
SMTP_FROM="AQEAW <no-reply@example.com>"
# Where new-application notifications are sent.
NOTIFY_TO=awards@example.com

# ---- Dashboard auth ----
# Signs session tokens and login-code challenges. Use a long random string.
# Changing it invalidates every signed-in session immediately.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ADMIN_SECRET=
# Only used on first boot: if no admin account exists yet, one is created with
# username "admin" and this password. Afterwards, manage accounts in the
# dashboard or with `npm run user:create`.
ADMIN_PASSWORD=
